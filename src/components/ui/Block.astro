---
/**
 * The document's core spread.
 *
 * Left column: a two-line title — medium over light — with the small
 * explanatory note beneath it. Right column: the specimen, artwork or diagram.
 *
 *   <Block title="Logotype" subtitle="Scaling">
 *     <Fragment slot="note">Small copy explaining the rule.</Fragment>
 *     <LogoScaling />
 *   </Block>
 */
interface Props {
	/** First line, set in the medium weight. */
	title?: string;
	/** Second line, set in the light weight at the same size. */
	subtitle?: string;
	/** Drop the left column and run the content the full width of the page. */
	full?: boolean;
	/** Heading level, so each page keeps a sensible outline. */
	as?: 'h2' | 'h3';
	id?: string;
	class?: string;
}

const { title, subtitle, full = false, as: Tag = 'h2', id, class: className } = Astro.props;

const hasNote = Astro.slots.has('note');
---

<section class:list={['block', full && 'block--full', className]} id={id}>
	{
		!full && (
			<div class="block__side">
				{title && (
					<Tag class="block__title doc-title">
						{title}
						{subtitle && <span class="doc-title__sub">{subtitle}</span>}
					</Tag>
				)}
				{hasNote && (
					<div class="block__note">
						<slot name="note" />
					</div>
				)}
			</div>
		)
	}

	<div class="block__body">
		{
			full && title && (
				<Tag class="block__title block__title--full doc-title">
					{title}
					{subtitle && <span class="doc-title__sub">{subtitle}</span>}
				</Tag>
			)
		}
		{full && hasNote && (
			<div class="block__note block__note--full">
				<slot name="note" />
			</div>
		)}
		<slot />
	</div>
</section>

<style>
	.block__note--full {
		margin-block-end: var(--space-l);
	}
</style>
