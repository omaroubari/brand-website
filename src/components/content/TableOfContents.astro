---
import TableOfContentsList from "./TableOfContentsList.astro";

const { items, minHeadingLevel, maxHeadingLevel } = Astro.props;
---

{
  Astro.props && (
    <starlight-toc
      data-min-h={Astro.props.minHeadingLevel}
      data-max-h={Astro.props.maxHeadingLevel}>
      <nav aria-labelledby="starlight__on-this-page">
        <h2 id="starlight__on-this-page">On this page</h2>
        <TableOfContentsList toc={Astro.props.items} />
      </nav>
    </starlight-toc>
  )
}

<script src="../../lib/toc"></script>
<style>
  #starlight__on-this-page {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-title-3--letter-spacing);
    font-weight: var(--text-title-3--font-weight);
    color: var(--foreground);
    margin-block-end: 0.5rem;
  }
</style>
