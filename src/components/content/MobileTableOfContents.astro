---
import TableOfContentsList from "./TableOfContentsList.astro";

const { items, minHeadingLevel, maxHeadingLevel } = Astro.props;
---

{
  Astro.props && (
    <mobile-starlight-toc
      data-min-h={Astro.props.minHeadingLevel}
      data-max-h={Astro.props.maxHeadingLevel}>
      <nav aria-labelledby="starlight__on-this-page--mobile">
        <details id="starlight__mobile-toc">
          <summary
            id="starlight__on-this-page--mobile"
            class="mx-auto flex w-full">
            <div class="flex w-full items-center justify-between gap-2 py-3">
              <span class="toggle text-muted-foreground ms-10 flex">
                On this page
                {/* <ArrowRight /> */}
              </span>
              <span class="display-current" />
            </div>
          </summary>
          <div class="dropdown">
            <TableOfContentsList toc={Astro.props.items} isMobile />
          </div>
        </details>
      </nav>
    </mobile-starlight-toc>
  )
}

<style>
  --sl-content-inline-start: 16px;

  nav {
    z-index: 10;
    background-color: var(--background);
    color: var(--foreground);
    border-bottom: var(--rule) solid var(--border);
  }
  @media (min-width: 50rem) {
    nav {
      inset-inline-start: var(--sl-content-inline-start, 0);
    }
  }
  summary {
    gap: 0.5rem;
    align-items: center;
    padding-inline: var(--page-gutter);
    font-size: var(--text-sm);
  }
  summary::marker,
  summary::-webkit-details-marker {
    display: none;
  }
  .toggle {
    flex-shrink: 0;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding-block: 0.5rem;
    padding-inline-start: 0.75rem;
    padding-inline-end: 0.75rem;
    line-height: 1;
    background-color: var(--background);
    color: var(--muted-foreground);
    user-select: none;
    cursor: pointer;
  }
  details[open] .toggle {
    color: var(--foreground);
    border-color: var(--primary);
  }
  details .toggle:hover {
    color: var(--foreground);
    border-color: var(--border);
  }
  details[open] .toggle:hover,
  details[open] .toggle:focus-visible {
    border-color: var(--primary);
  }
  :global([dir="rtl"]) .caret {
    transform: rotateZ(180deg);
  }
  details[open] .caret {
    transform: rotateZ(90deg);
  }
  .display-current {
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    color: var(--foreground);
  }
  .dropdown {
    max-height: 85vh;
    overflow-y: auto;
    background-color: var(--popover);
    color: var(--popover-foreground);
    box-shadow: 0 0.5rem 1.5rem
      color-mix(in srgb, var(--foreground) 12%, transparent);
    overscroll-behavior: contain;
  }
</style>

<script>
  import { StarlightTOC } from "../../lib/toc";

  class MobileStarlightTOC extends StarlightTOC {
    override set current(link: HTMLAnchorElement) {
      super.current = link;
      const display = this.querySelector(".display-current") as HTMLSpanElement;
      if (display) display.textContent = link.textContent;
    }

    constructor() {
      super();
      const details = this.querySelector("details");
      if (!details) return;
      const closeToC = () => {
        details.open = false;
      };
      // Close the table of contents whenever a link is clicked.
      details.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", closeToC);
      });
      // Close the table of contents when a user clicks outside of it.
      window.addEventListener("click", (e) => {
        if (!details.contains(e.target as Node)) closeToC();
      });
      // Or when they press the escape key.
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && details.open) {
          const hasFocus = details.contains(document.activeElement);
          closeToC();
          if (hasFocus) {
            const summary = details.querySelector("summary");
            if (summary) summary.focus();
          }
        }
      });
    }
  }

  customElements.define("mobile-starlight-toc", MobileStarlightTOC);
</script>
