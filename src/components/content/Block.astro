---
/**
 * The document's core block.
 *
 * By default, title, note and content share one column. Add `split` to place
 * the title and note in a side column beside the specimen, artwork or diagram.
 *
 *   <Block title="Logotype" subtitle="Scaling">
 *     <Fragment slot="note">Small copy explaining the rule.</Fragment>
 *     <LogoScaling />
 *   </Block>
 */
interface Props {
  /** First line, set in the medium weight. */
  title?: string;
  /** Second line, set in the light weight at the same size. */
  subtitle?: string;
  /** Put the title and note in a side column beside the content. */
  split?: boolean;
  /** Heading level, so each page keeps a sensible outline. */
  as?: "h2" | "h3";
  id?: string;
  class?: string;
}

const {
  title,
  subtitle,
  split = false,
  as: Tag = "h2",
  id,
  class: className,
} = Astro.props;

const hasNote = Astro.slots.has("note");
---

<section class:list={["block", split && "block--split", className]} id={id}>
  {
    split && (
      <div class="block__side">
        {title && (
          <Tag class="block__title doc-title">
            {title}
            {subtitle && <span class="doc-title__sub">{subtitle}</span>}
          </Tag>
        )}
        {hasNote && (
          <div class="block__note">
            <slot name="note" />
          </div>
        )}
      </div>
    )
  }

  <div class="block__body">
    {
      !split && title && (
        <Tag class="block__title block__title--body doc-title">
          {title}
          {subtitle && <span class="doc-title__sub">{subtitle}</span>}
        </Tag>
      )
    }
    {
      !split && hasNote && (
        <div class="block__note block__note--body">
          <slot name="note" />
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl) var(--space-4xl);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .block--split {
      grid-template-columns: var(--side-column) minmax(0, 1fr);
    }
  }

  .block__side {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .block__note {
    max-width: var(--measure);
  }

  .block__note > :global(* + *) {
    margin-block-start: 1em;
  }

  .block__note--body {
    margin-block-end: var(--space-l);
  }

  .block__title {
    font-family: var(--font-heading);
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    letter-spacing: var(--text-title--letter-spacing);
    font-weight: var(--text-title--font-weight);
    text-wrap: balance;
  }

  .block__title--body {
    margin-block-end: var(--space-l);
  }

  .block__body > :global(* + *) {
    margin-block-start: 1em;
  }
</style>
