---
/**
 * The document's core block.
 *
 * A block has three content regions: Markdown-rich `copy`, rich component
 * `content`, and an optional `note`. Add `split` to place the copy and note in
 * a side column beside the specimen, artwork or diagram.
 *
 *   <Block split>
 *     <Fragment slot="copy">
 *       ## Logotype
 *
 *       The primary logo is a logotype.
 *     </Fragment>
 *     <Fragment slot="note">Small copy explaining the rule.</Fragment>
 *     <Fragment slot="content"><LogoScaling /></Fragment>
 *   </Block>
 */
interface Props {
  /** Put the copy and note in a side column beside the content. */
  split?: boolean;
  id?: string;
  class?: string;
}

const { split = false, id, class: className } = Astro.props;

const hasNote = Astro.slots.has("note");
---

<section class:list={["block", split && "block--split", className]} id={id}>
  <div class="block__copy">
    <slot name="copy" />

    {
      hasNote && (
        <aside class="block__note">
          <slot name="note" />
        </aside>
      )
    }
  </div>

  <div class="block__content">
    <slot name="content" />
  </div>
</section>

<style>
  .block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl) var(--space-4xl);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .block--split {
      grid-template-columns: var(--side-column) minmax(0, 1fr);
    }
  }

  .block__copy > :global(* + *),
  .block__content > :global(* + *) {
    margin-block-start: 1em;
  }

  .block__copy > :global(h2:first-child) {
    margin-block-start: 0;
    font-family: var(--font-heading);
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    letter-spacing: var(--text-title--letter-spacing);
    font-weight: var(--text-title--font-weight);
    text-wrap: balance;
  }

  .block__note {
    max-width: var(--measure);
  }

  .block__note > :global(* + *) {
    margin-block-start: 1em;
  }
</style>
