---
import type { BrandConfig } from "../../brand/schema";
import type { Navigation } from "../../lib/types";
import type { UIStrings } from "../../lib/core/i18n-ui";
import Downloads from "../brand/Downloads.astro";
import Logo from "../brand/Logo.astro";
import ContentTree from "../nav/ContentTree.astro";

interface Props {
  brand: BrandConfig;
  ui: UIStrings;
  navigation: Navigation;
  numbering: boolean;
}

const { brand, ui, navigation, numbering } = Astro.props;
const { meta, contact } = brand;
---

<div class="page">
  <section class="cover">
    <div class="cover__mark">
      <Logo brand={brand} mark="brandmark" on="dark" width="2.75rem" />
    </div>
    <h1 class="cover__title">{meta.documentTitle}</h1>
    <p class="cover__foot">
      <span><strong>{meta.name}</strong> {meta.tagline}</span>
      <span class="cover__foot-mid"
        >{meta.documentTitle} {ui.brand.document}</span
      >
      <span class="cover__foot-end">{meta.year}©</span>
    </p>
  </section>

  <section class="contents" aria-labelledby="contents-title">
    <h2 class="doc-title contents__heading" id="contents-title">
      {ui.nav.contents}
    </h2>
    <ContentTree items={navigation.sidebar} numbering={numbering} />
  </section>

  <div class="ends">
    {
      (brand.downloads ?? []).length > 0 && (
        <section aria-labelledby="downloads-title">
          <h2 class="label" id="downloads-title">
            {ui.brand.assets}
          </h2>
          <Downloads
            brand={brand}
            class="ends__block"
            items={brand.downloads}
          />
        </section>
      )
    }

    <section aria-labelledby="contact-title">
      <h2 class="label" id="contact-title">{ui.brand.contact}</h2>
      <div class="ends__block contact">
        <p class="contact__lead">{ui.brand.contactLead}</p>
        <ul class="contact__list">
          {
            contact.email && (
              <li>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </li>
            )
          }
          {
            contact.website && (
              <li>
                <a
                  href={
                    contact.website.startsWith("http")
                      ? contact.website
                      : `https://${contact.website}`
                  }>
                  {contact.website}
                </a>
              </li>
            )
          }
          {contact.phone && <li>{contact.phone}</li>}
          {
            (contact.socials ?? []).map((social) => (
              <li>
                <a href={social.url} rel="noreferrer noopener" target="_blank">
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</div>

<style>
  .cover {
    background: var(--color-accent);
    color: var(--color-white);
    min-height: min(100svh, 64rem);
    padding: var(--space-l) var(--page-gutter);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-l);
  }

  .cover__mark {
    justify-self: end;
  }

  .cover__title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-weight: var(--text-display--font-weight);
    margin: 0;
    align-self: start;
    max-width: 9ch;
  }

  .cover__foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-s);
    align-self: end;
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
  }

  .cover__foot strong {
    font-weight: var(--text-label--font-weight);
  }

  .cover__foot-mid {
    text-align: center;
  }

  .cover__foot-end {
    text-align: end;
  }

  @media (max-width: 34rem) {
    .cover__foot {
      grid-template-columns: minmax(0, 1fr);
    }

    .cover__foot-mid,
    .cover__foot-end {
      text-align: start;
    }
  }

  .contents {
    display: grid;
    gap: var(--space-xl) var(--space-4xl);
    align-items: start;
    padding: var(--page-gutter);
  }

  @media (min-width: 48rem) {
    .contents {
      grid-template-columns: var(--side-column) minmax(0, 1fr);
    }
  }

  .contents__heading {
    margin: 0;
  }

  .ends {
    display: grid;
    gap: var(--space-xl);
    padding: var(--page-gutter);
  }

  @media (min-width: 48rem) {
    .ends {
      grid-template-columns: var(--side-column) minmax(0, 1fr);
      gap: var(--space-xl) var(--space-4xl);
    }
  }

  .ends__block {
    margin-block-start: var(--space-m);
  }

  .contact {
    display: grid;
    gap: var(--space-m);
  }

  .contact__lead {
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .contact__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .contact__list a {
    text-decoration: underline;
    text-decoration-style: dotted;
  }
</style>
