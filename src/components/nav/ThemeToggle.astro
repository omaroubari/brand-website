---
/**
 * Light/dark switch. Brand documents get read both ways, and the palette page
 * needs to be checked against both surfaces.
 *
 * The pre-paint script in `BaseLayout` reads the same `brand-theme` key.
 */
---

<button class="toggle" type="button" data-theme-toggle aria-pressed="false">
  <svg
    viewBox="0 0 16 16"
    width="14"
    height="14"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4">
    <circle cx="8" cy="8" r="3.25" class="toggle__sun-core"></circle>
    <path
      d="M8 1.25v1.5M8 13.25v1.5M14.75 8h-1.5M2.75 8h-1.5M12.77 3.23l-1.06 1.06M4.29 11.71l-1.06 1.06M12.77 12.77l-1.06-1.06M4.29 4.29L3.23 3.23"
      class="toggle__rays"></path>
    <path
      d="M13 9.4A5.6 5.6 0 1 1 6.6 3a4.6 4.6 0 0 0 6.4 6.4Z"
      class="toggle__moon"></path>
  </svg>
  <span class="toggle__label" data-theme-label>Light</span>
</button>

<style>
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: none;
    border: var(--rule) solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    font-weight: var(--text-label--font-weight);
    color: var(--muted-foreground);
    transition:
      color 0.15s var(--ease),
      border-color 0.15s var(--ease);
  }

  .toggle:hover {
    color: var(--foreground);
    border-color: var(--foreground);
  }

  .toggle__moon {
    display: none;
  }

  :global(:root[data-theme="dark"]) .toggle__sun-core,
  :global(:root[data-theme="dark"]) .toggle__rays {
    display: none;
  }

  :global(:root[data-theme="dark"]) .toggle__moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .toggle__sun-core,
    :global(:root:not([data-theme="light"])) .toggle__rays {
      display: none;
    }

    :global(:root:not([data-theme="light"])) .toggle__moon {
      display: block;
    }
  }
</style>

<script>
  const STORAGE_KEY = "brand-theme";
  const root = document.documentElement;

  function currentTheme(): "light" | "dark" {
    if (root.dataset.theme === "dark" || root.dataset.theme === "light")
      return root.dataset.theme;
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  function sync() {
    const theme = currentTheme();
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      "[data-theme-toggle]",
    )) {
      button.setAttribute("aria-pressed", String(theme === "dark"));
      const label = button.querySelector("[data-theme-label]");
      if (label) label.textContent = theme === "dark" ? "Dark" : "Light";
      button.setAttribute(
        "aria-label",
        `Switch to ${theme === "dark" ? "light" : "dark"} theme`,
      );
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  )) {
    button.addEventListener("click", () => {
      const next = currentTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Private browsing — the choice just will not persist.
      }
      sync();
    });
  }

  // Follow the OS while the visitor has not made an explicit choice.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (event) => {
      let stored: string | null = null;
      try {
        stored = localStorage.getItem(STORAGE_KEY);
      } catch {
        /* ignore */
      }
      if (stored) return;
      root.dataset.theme = event.matches ? "dark" : "light";
      sync();
    });

  sync();
</script>
