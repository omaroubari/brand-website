---
import type { NavNode } from "../../lib/types";
import { config } from "../../brand/config";

interface Props {
  items: readonly NavNode[];
  depth?: number;
}

const { items, depth = 0 } = Astro.props;
---

<ol
  class:list={[
    "contents__tree",
    depth === 0 && "contents__tree--root",
    depth === 0 && config.navigation.numbering && "contents__tree--numbered",
  ]}
  data-depth={depth}>
  {
    items.map((item, index) => (
      <li
        class:list={[
          "contents__item",
          item.kind === "group" && "contents__item--group",
        ]}>
        {item.route ? (
          <a class="contents__link" href={item.route}>
            {config.navigation.numbering && depth === 0 && (
              <span class="contents__num tnum">
                {String(index + 1).padStart(2, "0")}
              </span>
            )}
            <span class="contents__title">{item.label}</span>
          </a>
        ) : (
          <span class="contents__link contents__label">
            {config.navigation.numbering && depth === 0 && (
              <span class="contents__num tnum">
                {String(index + 1).padStart(2, "0")}
              </span>
            )}
            <span class="contents__title">{item.label}</span>
          </span>
        )}
        {item.kind === "group" && item.children.length > 0 && (
          <Astro.self items={item.children} depth={depth + 1} />
        )}
      </li>
    ))
  }
</ol>

<style>
  .contents__tree {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contents__tree:not(.contents__tree--root) {
    margin-inline-start: calc(3.5em + var(--space-l));
    margin-block-end: var(--space-2xs);
  }

  .contents__item {
    min-width: 0;
  }

  .contents__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--space-l);
    align-items: baseline;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.15s var(--ease);
    margin-block-end: var(--space-2xs);
  }

  .contents__label {
    cursor: default;
  }

  .contents__tree--numbered > .contents__item > .contents__link {
    grid-template-columns: 3.5em minmax(0, 1fr);
  }

  .contents__tree:not(.contents__tree--root) .contents__link {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    font-size: var(--text-title);
  }

  .contents__link:hover,
  .contents__link:focus-visible {
    color: var(--primary);
  }

  .contents__link:hover .contents__num {
    color: var(--primary);
  }

  .contents__num,
  .contents__title {
    font-family: var(--font-heading);
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    letter-spacing: var(--text-title--letter-spacing);
    font-weight: var(--text-title--font-weight);
  }

  .contents__tree:not(.contents__tree--root) .contents__title {
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }
</style>
