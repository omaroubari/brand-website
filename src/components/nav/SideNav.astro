---
import { brand } from '../../brand/config';
import { getSectionLinks } from '../../lib/sections';
import Logo from '../brand/Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = await getSectionLinks();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href;
---

<header class="rail">
	<div class="rail__inner">
		<a class="rail__brand" href="/" aria-label={`${brand.meta.name} ${brand.meta.documentTitle}`}>
			<Logo mark="logotype" width="10rem" />
			<span class="rail__doc">{brand.meta.documentTitle}</span>
		</a>

		<button
			class="rail__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="rail-nav"
			data-nav-toggle
		>
			<span class="rail__toggle-label">Contents</span>
			<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
				<path d="M2 4h12M2 8h12M2 12h12" class="rail__icon-open" />
				<path d="M3.5 3.5l9 9M12.5 3.5l-9 9" class="rail__icon-close" />
			</svg>
		</button>

		<nav class="rail__nav" id="rail-nav" aria-label="Sections">
			<ol class="rail__list">
				{
					links.map((link) => (
						<li>
							<a
								class="rail__link"
								href={link.href}
								aria-current={isCurrent(link.href) ? 'page' : undefined}
							>
								{brand.numbering && <span class="rail__num tnum">{link.number}</span>}
								<span class="rail__title">{link.title}</span>
							</a>
						</li>
					))
				}
			</ol>
		</nav>

		<div class="rail__foot">
			<ThemeToggle />
			<p class="caption rail__colophon">
				{brand.meta.name} © {brand.meta.year}<br />
				Version {brand.meta.version}
			</p>
		</div>
	</div>
</header>

<style>
	.rail {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--surface);
		border-block-end: var(--rule) solid var(--line);
	}

	.rail__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: var(--space-m);
		padding: var(--space-m) var(--page-gutter);
	}

	.rail__brand {
		display: grid;
		gap: 0.4rem;
		text-decoration: none;
		min-width: 0;
	}

	.rail__doc {
		font-size: 0.6875rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		font-weight: 500;
		color: var(--muted);
	}

	.rail__toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		background: none;
		border: var(--rule) solid var(--line);
		border-radius: 999px;
		padding: 0.4rem 0.75rem;
		cursor: pointer;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-weight: 500;
		color: var(--ink);
	}

	.rail__toggle:hover {
		border-color: var(--ink);
	}

	.rail__icon-close {
		display: none;
	}

	.rail__toggle[aria-expanded='true'] .rail__icon-open {
		display: none;
	}

	.rail__toggle[aria-expanded='true'] .rail__icon-close {
		display: block;
	}

	.rail__nav {
		grid-column: 1 / -1;
		display: none;
		padding-block-start: var(--space-m);
	}

	.rail__nav[data-open] {
		display: block;
	}

	.rail__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.1rem;
	}

	.rail__link {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: var(--space-xs);
		align-items: baseline;
		padding: 0.35rem 0;
		text-decoration: none;
		color: var(--muted);
		transition: color 0.15s var(--ease);
	}

	.rail__link:hover {
		color: var(--ink);
	}

	.rail__link[aria-current='page'] {
		color: var(--ink);
	}

	.rail__link[aria-current='page'] .rail__num {
		color: var(--accent);
	}

	.rail__num {
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		color: color-mix(in srgb, currentColor 65%, transparent);
	}

	.rail__title {
		font-family: var(--font-display);
		font-size: 0.9375rem;
		line-height: 1.25;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.rail__foot {
		display: none;
	}

	.rail__colophon {
		font-size: 0.6875rem;
		line-height: 1.5;
	}

	/* ── Desktop: a real rail ───────────────────────────────────────────── */

	@media (min-width: 60rem) {
		.rail {
			border-block-end: 0;
			border-inline-end: var(--rule) solid var(--line);
			height: 100dvh;
		}

		.rail__inner {
			grid-template-columns: minmax(0, 1fr);
			align-content: start;
			height: 100%;
			padding: var(--space-xl) var(--space-l);
			gap: var(--space-xl);
			overflow-y: auto;
		}

		.rail__toggle {
			display: none;
		}

		.rail__nav {
			display: block;
			padding-block-start: 0;
		}

		.rail__foot {
			display: grid;
			gap: var(--space-m);
			justify-items: start;
			margin-block-start: auto;
			padding-block-start: var(--space-l);
		}
	}
</style>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const nav = document.getElementById('rail-nav');

	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!open));
		nav?.toggleAttribute('data-open', !open);
	});

	// Close on Escape so keyboard users are not trapped behind the overlay.
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		if (toggle?.getAttribute('aria-expanded') !== 'true') return;
		toggle.setAttribute('aria-expanded', 'false');
		nav?.removeAttribute('data-open');
		toggle.focus();
	});
</script>
