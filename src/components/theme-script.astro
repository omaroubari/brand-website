---
import type { ThemeSetting } from "@/lib/theme-state";

interface Props {
  defaultTheme?: ThemeSetting;
}

const { defaultTheme = "system" } = Astro.props;
---

{
  /*
  Runs before paint to prevent a flash of the wrong theme. The inline script
  publishes `defaultTheme` as a global that the bundled theme store reads. Keep
  both scripts in the <head> so stored preferences resolve before paint.
*/
}
<script is:inline define:vars={{ defaultTheme }}>
  window.defaultTheme = defaultTheme;
</script>
<script>
  import "@/lib/theme";
</script>
