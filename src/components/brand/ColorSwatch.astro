---
import type { BrandSwatch } from "../../brand/types";
import { hexToRgb, readableOn, tintRamp } from "../../brand/tokens";

interface Props {
  color: BrandSwatch;
  print?: boolean;
}

const { color, print = true } = Astro.props;

const ink = color.on ?? readableOn(color.hex);
const [r, g, b] = hexToRgb(color.hex);
const tints = color.tints ? tintRamp(color.hex) : [];
const hex = color.hex.replace("#", "").toLowerCase();
---

<article
  class="swatch"
  style={`--swatch-bg: ${color.hex}; --swatch-ink: ${ink}; --span: ${color.span ?? 1}; --rows: ${color.rows ?? 1};`}>
  <button
    class="swatch__field"
    type="button"
    data-copy-color={color.hex}
    aria-label={`Copy ${color.name} hex code ${color.hex} to clipboard`}>
    <span class="swatch__copy-icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round">
        <rect width="14" height="14" x="8" y="8" rx="2"></rect>
        <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
        ></path>
      </svg>
    </span>
    <h3 class="swatch__name">{color.name}</h3>

    <div class="swatch__specs">
      <p class="swatch__spec mono"><span>HEX</span> {hex}</p>
      {
        print && (
          <p class="swatch__spec mono">
            <span>RGB</span> {r} {g} {b}
          </p>
        )
      }
      {
        print && color.cmyk && (
          <p class="swatch__spec mono">
            <span>CMYK</span> {color.cmyk.join(" ")}
          </p>
        )
      }
      {
        print && color.pantone && (
          <p class="swatch__spec mono">
            <span>PMS</span> {color.pantone}
          </p>
        )
      }
    </div>
  </button>

  {
    tints.length > 0 && (
      <div
        class="swatch__tints"
        role="img"
        aria-label={`Tint ramp for ${color.name}`}>
        {tints.map((t) => (
          <span class="swatch__tint" style={`background: ${t};`} />
        ))}
      </div>
    )
  }

  {color.usage && <p class="caption swatch__usage">{color.usage}</p>}
</article>

<style>
  .swatch {
    grid-column: span var(--span);
    grid-row: span var(--rows);
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto auto;
    min-width: 0;
  }

  .swatch__field {
    background: var(--swatch-bg);
    color: var(--swatch-ink);
    border: 0;
    font: inherit;
    text-align: start;
    position: relative;
    padding: var(--space-m);
    padding-inline-end: calc(var(--space-m) + 1.5rem);
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-m);
    min-height: 11rem;
    width: 100%;
    cursor: copy;
    transition: filter 0.15s var(--ease);
  }

  .swatch__field:hover {
    filter: brightness(1.05);
  }

  .swatch__field:active {
    filter: brightness(0.97);
  }

  .swatch__copy-icon {
    position: absolute;
    inset-block-start: var(--space-m);
    inset-inline-end: var(--space-m);
    width: 1.1rem;
    height: 1.1rem;
    opacity: 0;
    transition: opacity 0.15s var(--ease);
  }

  .swatch__copy-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .swatch__field:hover .swatch__copy-icon,
  .swatch__field:focus-visible .swatch__copy-icon {
    opacity: 1;
  }

  /* The name sits large at the top of the field; the build values sit small in
	   the bottom corner, as on the printed colour page. */
  .swatch__name {
    font-family: var(--font-display);
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    letter-spacing: var(--text-title--letter-spacing);
    font-weight: var(--text-title--font-weight);
    /* Compound names ("Orange/Red") must break rather than run into the
		   neighbouring field. */
    overflow-wrap: break-word;
  }

  .swatch__specs {
    align-self: end;
    display: grid;
    gap: 0.15rem;
  }

  .swatch__spec {
    display: grid;
    grid-template-columns: 3.1rem minmax(0, 1fr);
    gap: 0.35rem;
    opacity: 0.85;
  }

  .swatch__spec span {
    opacity: 0.6;
  }

  .swatch__tints {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    height: 1.5rem;
  }

  .swatch__usage {
    margin-block-start: var(--space-xs);
    text-wrap: pretty;
  }
</style>
