---
import { brand } from "../../brand/config";
import { contrastGrade, contrastRatio } from "../../brand/tokens";

interface Props {
  /** Restrict the matrix to these palette ids. */
  only?: string[];
  /** Ratio for normal body text. WCAG AA is 4.5. */
  threshold?: number;
  class?: string;
}

const { only, threshold = 4.5, class: className } = Astro.props;

const colors = only
  ? brand.colors.filter((c) => only.includes(c.id))
  : brand.colors;

const rows = colors.map((fg) => ({
  fg,
  cells: colors.map((bg) => {
    const ratio = contrastRatio(fg.hex, bg.hex);
    return {
      bg,
      ratio,
      grade: contrastGrade(ratio),
      passes: ratio >= threshold,
      // A colour on itself would print invisibly; say so instead.
      same: bg.hex.toLowerCase() === fg.hex.toLowerCase(),
    };
  }),
}));
---

<div class:list={["matrix-wrap", "bleed", "escape", className]}>
  <table class="matrix">
    <caption class="visually-hidden">
      WCAG contrast ratios for every pairing in the palette. Text colour runs
      down the rows, background colour across the columns.
    </caption>
    <thead>
      <tr>
        <th scope="col"><span class="label">Text on →</span></th>
        {
          colors.map((c) => (
            <th scope="col" class="label matrix__head">
              {c.name}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row" class="label matrix__head matrix__head--row">
              {row.fg.name}
            </th>
            {row.cells.map((cell) =>
              cell.same ? (
                <td class="matrix__cell matrix__cell--same">
                  <span class="matrix__ratio mono" aria-hidden="true">
                    —
                  </span>
                  <span class="visually-hidden">Same colour, no contrast</span>
                </td>
              ) : (
                <td
                  class:list={[
                    "matrix__cell",
                    !cell.passes && "matrix__cell--fail",
                  ]}
                  style={`background: ${cell.bg.hex}; color: ${row.fg.hex};`}>
                  <span class="matrix__ratio mono">
                    {cell.ratio.toFixed(2)}
                  </span>
                  <span class="matrix__grade mono">{cell.grade}</span>
                </td>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .matrix-wrap {
    border: var(--rule) solid var(--line);
  }

  .matrix {
    border-collapse: collapse;
    width: 100%;
    min-width: 34rem;
  }

  .matrix__head {
    padding: var(--space-xs) var(--space-s);
    text-align: start;
    vertical-align: bottom;
    white-space: nowrap;
    font-weight: var(--text-label--font-weight);
  }

  .matrix__head--row {
    border-inline-end: var(--rule) solid var(--line);
  }

  .matrix__cell {
    padding: var(--space-s);
    text-align: start;
    vertical-align: top;
    min-width: 5.5rem;
    line-height: var(--text-body--line-height);
  }

  .matrix__ratio {
    display: block;
  }

  .matrix__grade {
    display: block;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    font-weight: var(--text-label--font-weight);
    text-transform: uppercase;
    opacity: 0.75;
  }

  /* A failing pair is struck through, so it reads as unusable even where the
	   ratio itself is illegible — which is exactly the point. */
  .matrix__cell--fail .matrix__ratio {
    text-decoration: line-through;
  }

  .matrix__cell--same {
    color: var(--muted);
    background: none;
  }
</style>
