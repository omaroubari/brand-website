---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	/** e.g. "Target audience 1 — founders of small companies". */
	role?: string;
	image?: ImageMetadata | string;
	/** Demographic rows shown under the name. */
	facts?: Array<{ term: string; value: string }>;
	class?: string;
}

const { name, role, image, facts = [], class: className } = Astro.props;
---

<article class:list={['persona', 'escape', className]}>
	<div class="persona__media">
		{
			image && typeof image !== 'string' ? (
				<Image src={image} alt="" class="persona__img" widths={[400, 700]} sizes="(min-width: 48rem) 30vw, 100vw" />
			) : image ? (
				<img class="persona__img" src={image} alt="" loading="lazy" decoding="async" />
			) : (
				<span class="caption persona__placeholder">Portrait pending</span>
			)
		}
	</div>

	<div class="persona__body">
		{role && <p class="label">{role}</p>}
		<h3 class="persona__name">{name}</h3>

		{
			facts.length > 0 && (
				<dl class="persona__facts">
					{facts.map((fact) => (
						<div class="persona__fact">
							<dt class="label">{fact.term}</dt>
							<dd>{fact.value}</dd>
						</div>
					))}
				</dl>
			)
		}

		<div class="persona__notes">
			<slot />
		</div>
	</div>
</article>

<style>
	.persona {
		display: grid;
		gap: var(--space-l);
		align-items: start;
	}

	@media (min-width: 48rem) {
		.persona {
			grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
		}
	}

	.persona__media {
		aspect-ratio: 3 / 4;
		background: var(--raised);
		overflow: hidden;
		display: grid;
		place-items: center;
	}

	.persona__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.persona__body {
		display: grid;
		gap: var(--space-s);
		align-content: start;
	}

	.persona__name {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		font-weight: 500;
	}

	.persona__facts {
		margin: 0;
		display: grid;
		gap: 0.3rem;
	}

	.persona__fact {
		display: grid;
		grid-template-columns: minmax(6rem, 9rem) minmax(0, 1fr);
		gap: var(--space-s);
		align-items: baseline;
		border-block-start: var(--rule) solid var(--line);
		padding-block-start: 0.3rem;
	}

	.persona__fact dd {
		margin: 0;
	}

	.persona__notes > :global(* + *) {
		margin-block-start: var(--space-s);
	}
</style>
