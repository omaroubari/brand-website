---
import { brand } from "../../brand/config";
import type { BrandSwatch } from "../../brand/types";
import ColorSwatch from "./ColorSwatch.astro";

interface Props {
  /** Limit and order named swatches by id. Defaults to every configured swatch. */
  only?: string[];
  /** Limit the palette to a named group from the brand configuration. */
  category?: BrandSwatch["category"];
  /** Show CMYK / RGB breakdowns alongside the hex. */
  print?: boolean;
  class?: string;
}

const { only, category, print = true, class: className } = Astro.props;

const colors = only
  ? only.map((id) => {
      const match = brand.colors.swatches.find((c) => c.id === id);
      if (!match) throw new Error(`[ColorPalette] Unknown colour id "${id}"`);
      return match;
    })
  : category
    ? brand.colors.swatches.filter((color) => color.category === category)
    : brand.colors.swatches;
---

<div class:list={["palette", "escape", className]} data-color-palette>
  {colors.map((c) => <ColorSwatch color={c} print={print} />)}
</div>

<style>
  /* Fields butt up against each other with only a hairline between, so the
	   palette reads as one block of colour across the page. */
  .palette {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
  }

  /* Three columns, so a two-row swatch on the left leaves a 2 × 2 field beside
	   it — the arrangement the printed colour page uses, and wide enough for a
	   long colour name to stay on one line. */
  @media (min-width: 48rem) {
    .palette {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: minmax(14rem, auto);
    }
  }
</style>
