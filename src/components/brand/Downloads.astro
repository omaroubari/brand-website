---
import { brand } from "../../brand/config";
import type { BrandDownload } from "../../brand/types";

interface Props {
  /** Defaults to `downloads` in the brand config. */
  items?: BrandDownload[];
  class?: string;
}

const { items = brand.downloads ?? [], class: className } = Astro.props;
---

{
  items.length > 0 && (
    <ul class:list={["downloads", "escape", className]}>
      {items.map((item) => (
        <li class="downloads__item">
          <a class="downloads__link" href={item.href} download>
            <span class="downloads__label">{item.label}</span>
            <span class="downloads__meta">
              {item.format && <span class="mono">{item.format}</span>}
              {item.size && (
                <span class="mono downloads__size">{item.size}</span>
              )}
              <svg
                viewBox="0 0 16 16"
                width="14"
                height="14"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4">
                <path d="M8 2v9M4.5 7.5 8 11l3.5-3.5M2.5 13.5h11" />
              </svg>
            </span>
          </a>
          {item.note && <p class="caption downloads__note">{item.note}</p>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .downloads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .downloads__item {
    border-block-start: var(--rule) solid var(--line);
    padding-block: var(--space-s);
  }

  .downloads__item:last-child {
    border-block-end: var(--rule) solid var(--line);
  }

  .downloads__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    text-decoration: none;
  }

  .downloads__label {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 500;
  }

  .downloads__link:hover .downloads__label {
    color: var(--accent);
  }

  .downloads__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    color: var(--muted);
    flex: none;
  }

  .downloads__size {
    opacity: 0.7;
  }

  .downloads__note {
    margin-block-start: 0.15rem;
    max-width: var(--measure);
  }
</style>
