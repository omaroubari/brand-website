---
import { config } from "../brand/config";
import CoverPage from "../components/content/CoverPage.astro";
import { defaultLocale, getLocale, LOCALE_COOKIE_NAME } from "../i18n";
import { i18nEnabled } from "../lib/core/i18n";
import { getContentTree } from "../lib/core/tree";
import BaseLayout from "../layouts/BaseLayout.astro";

// A prefixed multilingual site redirects this route on demand so the locale
// cookie can choose the destination. Otherwise this is the default cover.
export const prerender = false;

if (i18nEnabled(config) && !config.i18n.hideDefaultLocalePrefix) {
  return Astro.redirect(
    `/${getLocale(Astro.cookies.get(LOCALE_COOKIE_NAME)?.value ?? defaultLocale)}/`,
    302,
  );
}

const tree = await getContentTree();
---

<BaseLayout locale={defaultLocale} navigation={tree.navigation}>
  <CoverPage locale={defaultLocale} navigation={tree.navigation} />
</BaseLayout>
