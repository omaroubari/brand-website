---
import { config } from "../../brand/config";
import CoverPage from "../../components/content/CoverPage.astro";
import { i18nEnabled } from "../../lib/core/i18n";
import { getNavigation } from "../../lib/core/navigation";
import { getContentTree } from "../../lib/core/tree";
import RootLayout from "../../layouts/RootLayout.astro";
import type { Navigation } from "../../lib/types";

interface Props {
  locale: string;
  navigation: Navigation;
}

export async function getStaticPaths() {
  if (!i18nEnabled(config)) {
    return [];
  }

  const tree = await getContentTree();
  return config.i18n.locales
    .filter(
      ({ code }) =>
        !config.i18n.hideDefaultLocalePrefix ||
        code !== config.i18n.defaultLocale,
    )
    .map(({ code }) => ({
      params: { lang: code },
      props: { locale: code, navigation: getNavigation(tree, code) },
    }));
}

const { locale, navigation } = Astro.props;
---

<RootLayout locale={locale} navigation={navigation}>
  <CoverPage locale={locale} navigation={navigation} />
</RootLayout>
