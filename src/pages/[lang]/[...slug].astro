---
import { render } from "astro:content";
import {
  SUPPORTED_LOCALES,
  getSections,
  sectionNumber,
  sectionSlug,
  type Locale,
} from "../../lib/sections";
import SectionLayout from "../../layouts/SectionLayout.astro";

export async function getStaticPaths() {
  const paths = [];
  for (const locale of SUPPORTED_LOCALES) {
    const sections = await getSections(locale);
    paths.push(
      ...sections.map((entry, index) => ({
        params: { lang: locale, slug: sectionSlug(entry) },
        props: { entry, locale, number: sectionNumber(entry, index) },
      })),
    );
  }
  return paths;
}

const { entry, locale } = Astro.props as {
  entry: Awaited<ReturnType<typeof getSections>>[number];
  locale: Locale;
  number: string;
};
const number = Astro.props.number as string;
const { Content, headings } = await render(entry);
---

<SectionLayout
  id={entry.id}
  title={entry.data.title}
  number={number}
  summary={entry.data.summary}
  seo={entry.data.seo}
  headings={headings}>
  <Content />
</SectionLayout>
