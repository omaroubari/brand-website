---
import "../styles/global.css";
import { Font } from "astro:assets";
import { brand } from "../brand/config";
import { brandStyleSheet } from "../brand/tokens";
import type { Navigation } from "../lib/types";
import { getInitialThemeAttributes } from "../lib/theme-state";
import {
  getDirection,
  getLocale,
  getLocaleFromPath,
  getLocalizedPath,
  LOCALE_COOKIE_NAME,
  defaultLocale,
  supportedLocales,
  resolveBrand,
} from "../i18n";
import SideNav from "../components/nav/SideNav";
import ColorPaletteInteractions from "../components/brand/ColorPaletteInteractions";
import "../styles/global.css";
import ThemeScript from "@/components/theme-script.astro";

interface Props {
  locale?: string;
  navigation?: Navigation;
  title?: string;
  description?: string;
  /** Drop the nav rail — used by the cover page. */
  bare?: boolean;
  class?: string;
}

const { title, description, bare = false, class: className } = Astro.props;

const locale = getLocale(
  Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname),
);
const localizedBrand = resolveBrand(brand, locale);

const pageTitle = title
  ? `${title} — ${localizedBrand.meta.name} ${localizedBrand.meta.documentTitle}`
  : `${localizedBrand.meta.name} — ${localizedBrand.meta.documentTitle}`;

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://localhost",
);
const currentRoute = Astro.url.pathname.replace(/\/$/, "") || "/";
const tokens = brandStyleSheet(brand);
const initialTheme = getInitialThemeAttributes(brand.theme.default);
const alternateLocales = supportedLocales.filter(
  (candidate) => candidate !== locale,
);

const navigationItems = bare ? [] : (Astro.props.navigation?.sidebar ?? []);
const navigationRoot = Astro.props.navigation?.root ?? "/";
---

<!doctype html>
<html
  lang={locale}
  dir={getDirection(locale)}
  data-theme={initialTheme.theme}
  data-theme-preference={initialTheme.preference}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content={description ?? localizedBrand.meta.description}
    />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={locale} href={canonical.href} />
    {
      alternateLocales.map((candidate) => (
        <link
          rel="alternate"
          hreflang={candidate}
          href={
            new URL(
              getLocalizedPath(Astro.url.pathname, candidate),
              Astro.site ?? "https://localhost",
            ).href
          }
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(
        getLocalizedPath(Astro.url.pathname, defaultLocale),
        Astro.site ?? "https://localhost",
      ).href}
    />
    <link
      rel="icon"
      href={localizedBrand.logo.favicon ?? "/favicon.svg"}
      type="image/svg+xml"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content={description ?? localizedBrand.meta.description}
    />
    <meta property="og:url" content={canonical.href} />
    {
      localizedBrand.meta.ogImage && (
        <meta
          property="og:image"
          content={new URL(localizedBrand.meta.ogImage, canonical).href}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Guidelines are for the client, not for search. Remove if the site is public. -->
    <meta name="robots" content="noindex, nofollow" />

    <Font cssVariable="--font-brand" preload />
    <Font cssVariable="--font-arabic" preload />
    <style is:global set:html={tokens}></style>
    <ThemeScript defaultTheme={brand.theme.default} />
    <script
      is:inline
      define:vars={{ locale, localeCookieName: LOCALE_COOKIE_NAME }}
    >
      document.cookie = `${localeCookieName}=${encodeURIComponent(locale)}; Path=/; Max-Age=31536000; SameSite=Lax`;
    </script>
  </head>

  <body>
    <ColorPaletteInteractions locale={locale} client:load />
    {
      bare ? (
        <slot />
      ) : (
        <div class:list={["min-h-dvh", className]}>
          <SideNav
            items={navigationItems}
            currentRoute={currentRoute}
            locale={locale}
            navigationRoot={navigationRoot}
            client:load>
            <main class="main" id="content">
              <slot />
            </main>
          </SideNav>
        </div>
      )
    }
  </body>
</html>
