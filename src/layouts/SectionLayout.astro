---
import BaseLayout from "./BaseLayout.astro";
import Pager from "../components/nav/Pager.astro";
import SectionOpener from "../components/content/SectionOpener.astro";
import TableOfContents from "../components/content/TableOfContents.astro";
import MobileTableOfContents from "../components/content/MobileTableOfContents.astro";
import type { MarkdownHeading } from "astro";
import { generateToC } from "../lib/generate-toc";

interface Props {
  id: string;
  title: string;
  number?: string;
  summary?: string;
  seo?: { title?: string; description?: string };
  headings: MarkdownHeading[];
}

const { id, title, number, summary, seo, headings } = Astro.props;

const tocConfig = {
  minHeadingLevel: 0,
  maxHeadingLevel: 3,
};

const tocHeadings = headings.filter(
  ({ depth }) =>
    depth >= tocConfig.minHeadingLevel && depth <= tocConfig.maxHeadingLevel,
);
const shouldRenderToc = tocHeadings.length >= 2;
const tocItems = shouldRenderToc ? generateToC(headings, tocConfig) : [];
---

<BaseLayout
  title={seo?.title ?? title}
  description={seo?.description ?? summary}>
  <div class="page">
    <SectionOpener number={number} title={title} summary={summary} />
    <div class="section">
      <div class="section__content">
        <article class="prose section__body">
          <slot />
        </article>

        <div class="section__tail">
          <Pager id={id} />
        </div>
      </div>
      {
        shouldRenderToc && (
          <aside class="scrollbar-thumb-border sticky top-0 hidden h-dvh scrollbar-thin scrollbar-track-transparent overflow-y-auto px-4 pt-(--page-gutter) pb-10 text-sm xl:block">
            <div class="max-lg:hidden lg:block">
              <TableOfContents
                minHeadingLevel={tocConfig.minHeadingLevel}
                maxHeadingLevel={tocConfig.maxHeadingLevel}
                items={tocItems}
              />
            </div>
            <div class="max-lg:block lg:hidden">
              <MobileTableOfContents
                minHeadingLevel={tocConfig.minHeadingLevel}
                maxHeadingLevel={tocConfig.maxHeadingLevel}
                items={tocItems}
              />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .section {
    display: grid;
    grid-template-columns: 1fr 16rem;
    align-items: stretch;
  }

  .section__content {
    min-width: 0;
    padding-inline: var(--page-gutter);
    padding-bottom: var(--space-4xl);
  }

  .section__body {
    padding-block: var(--page-gutter);
  }

  .section__body > :global(h2:first-of-type) {
    margin-block-start: 0;
  }

  /* Spreads sit far apart, the way pages do in the printed document. */
  .section__body > :global(.block + .block) {
    margin-block-start: var(--space-4xl);
  }
</style>
