---
import BaseLayout from "./BaseLayout.astro";
import Pager from "../components/nav/Pager.astro";
import SectionOpener from "../components/content/SectionOpener.astro";
import TableOfContents from "../components/content/TableOfContents.astro";
import MobileTableOfContents from "../components/content/MobileTableOfContents.astro";
import type { MarkdownHeading } from "astro";
import { generateToC } from "../lib/generate-toc";
import type { ContentPageProps } from "../lib/core/rendering";
import { findBreadcrumbs } from "../components/nav/nav-utils";

interface Props extends ContentPageProps {
  headings: MarkdownHeading[];
}

const { page, navigation, headings } = Astro.props;
const {
  title,
  description,
  meta: { seo },
} = page;

const crumbs = findBreadcrumbs(navigation.sidebar, page.route);
// Index routes consist only of their group segments and have no eyebrow.
const eyebrow =
  page.segments.length === page.groups.length
    ? undefined
    : crumbs
        .slice(0, -1)
        .map((crumb) => crumb.label)
        .join(" / ");

const tocConfig = {
  minHeadingLevel: 2,
  maxHeadingLevel: 3,
};

const tocHeadings = headings.filter(
  ({ depth }) =>
    depth >= tocConfig.minHeadingLevel && depth <= tocConfig.maxHeadingLevel,
);
const shouldRenderToc = tocHeadings.length >= 2;
const tocItems = shouldRenderToc ? generateToC(headings, tocConfig) : [];
---

<BaseLayout
  locale={page.locale}
  navigation={navigation}
  title={seo?.title ?? title}
  description={seo?.description ?? description}>
  <div class="page">
    {
      shouldRenderToc && (
        <div class="section__mobile-toc lg:hidden">
          <MobileTableOfContents
            minHeadingLevel={tocConfig.minHeadingLevel}
            maxHeadingLevel={tocConfig.maxHeadingLevel}
            items={tocItems}
          />
        </div>
      )
    }
    <SectionOpener
      locale={page.locale}
      eyebrow={eyebrow}
      title={title}
      summary={description}
    />
    <div class="section">
      <div class="section__content">
        <article class="prose section__body">
          <slot />
        </article>

        <div class="section__tail">
          <Pager page={page} navigation={navigation} />
        </div>
      </div>
      {
        shouldRenderToc && (
          <aside class="scrollbar-thumb-border sticky top-0 hidden h-dvh scrollbar-thin scrollbar-track-transparent overflow-y-auto px-4 pt-(--page-gutter) pb-10 text-sm lg:block">
            <TableOfContents
              minHeadingLevel={tocConfig.minHeadingLevel}
              maxHeadingLevel={tocConfig.maxHeadingLevel}
              items={tocItems}
            />
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
  }

  @media (min-width: 64rem) {
    .section {
      grid-template-columns: minmax(0, 1fr) 16rem;
    }
  }

  .section__mobile-toc {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-background);
  }

  @media (max-width: 63.999rem) {
    :global(
      [data-page-shell]:has(.section__mobile-toc)
        > [data-slot="sidebar-trigger"]
    ) {
      position: fixed;
      inset-block-start: 0.75rem;
      inset-inline-start: var(--page-gutter);
      color: var(--foreground);
      border-color: var(--border);
    }

    :global(
      [data-page-shell]:has(.section__mobile-toc)
        > [data-slot="sidebar-trigger"]:hover
    ) {
      background-color: var(--muted);
      color: var(--foreground);
    }
  }

  .section__content {
    min-width: 0;
    padding-inline: var(--page-gutter);
    padding-bottom: var(--space-4xl);
  }

  .section__body {
    padding-block: var(--page-gutter);
  }

  .section__body > :global(h2:first-of-type) {
    margin-block-start: 0;
  }

  /* Spreads sit far apart, the way pages do in the printed document. */
  .section__body > :global(.block + .block) {
    margin-block-start: var(--space-4xl);
  }
</style>
