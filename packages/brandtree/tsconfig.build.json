{
  "extends": "./tsconfig.json",
  "include": ["src/index.ts", "src/cli/**/*.ts", "src/astro/prerender-deps.ts"],
  "exclude": [],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "types": ["node"]
  }
}
