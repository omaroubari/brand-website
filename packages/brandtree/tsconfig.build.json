{
  "extends": "./tsconfig.json",
  "include": [
    "src/index.ts",
    "src/cli/**/*.ts",
    "src/astro/prerender-deps.ts",
    "src/astro/dev-content-modules.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "types": ["node"]
  }
}
