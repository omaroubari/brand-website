{
  "name": "brandtree",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./brand/*": "./src/brand/*",
    "./components": "./src/components/mdx.ts",
    "./components/*": "./src/components/*",
    "./core/*": "./src/core/*",
    "./runtime": "./src/runtime.ts",
    "./styles.css": "./src/styles/global.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "astro check",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "image-size": "2.0.2",
    "jiti": "^2.7.0",
    "lucide-react": "^1.30.0",
    "motion": "^12.43.0",
    "pathe": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "takumi-js": "2.2.1",
    "tinyglobby": "^0.2.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/"
  ]
}
