---
interface Props {
  /** Icons discovered by the consuming app. */
  icons: Array<{ name: string; svg: string }>;
  /** Restrict and order by filename, without the extension. */
  only?: string[];
  /** Grid the icons are drawn on, shown as an overlay on the first tile. */
  unit?: number;
  /** Version label printed under each icon. */
  version?: string;
  cols?: number;
  class?: string;
}

const {
  icons: discoveredIcons,
  only,
  unit = 24,
  version = "v1.0",
  cols = 4,
  class: className,
} = Astro.props;

const all = [...discoveredIcons].sort((a, b) => a.name.localeCompare(b.name));

const icons = only
  ? only.map((name) => {
      const match = all.find((i) => i.name === name);
      if (!match)
        throw new Error(
          `[IconGrid] No icon named "${name}" in the supplied icon set.`,
        );
      return match;
    })
  : all;

const label = (name: string) =>
  name.charAt(0).toUpperCase() + name.slice(1).replace(/-/g, " ");
---

<div
  class:list={["icons", "escape", className]}
  style={`--cols: ${cols}; --unit: ${unit};`}>
  {
    icons.map((icon, i) => (
      <figure class="icons__item">
        <div class:list={["icons__field", i === 0 && "icons__field--gridded"]}>
          <span class="icons__art" set:html={icon.svg} />
        </div>
        <figcaption class="caption icons__caption">
          <span class="icons__name">{label(icon.name)}</span>
          <span class="icons__version mono">{version}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .icons {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-m);
  }

  @media (max-width: 47.999rem) {
    .icons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .icons__item {
    margin: 0;
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .icons__field {
    position: relative;
    aspect-ratio: 1;
    border: var(--rule) solid var(--border);
    display: grid;
    place-items: center;
    padding: 22%;
  }

  /* The first tile shows the pixel grid the set is drawn on. */
  .icons__field--gridded::before {
    content: "";
    position: absolute;
    inset: 22%;
    background-image:
      linear-gradient(to right, var(--border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 1px, transparent 1px);
    background-size:
      calc(100% / var(--unit)) calc(100% / var(--unit)),
      calc(100% / var(--unit)) calc(100% / var(--unit));
    background-repeat: repeat;
    opacity: 0.7;
  }

  .icons__art {
    display: block;
    width: 100%;
    position: relative;
  }

  .icons__art :global(svg) {
    width: 100%;
    height: auto;
    color: var(--foreground);
  }

  .icons__caption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .icons__name {
    color: var(--foreground);
  }
</style>
