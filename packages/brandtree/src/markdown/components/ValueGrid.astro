---
import type { ValueGridProps as Props } from "../../components";
const { items, numbered = true } = Astro.props;
const List = numbered ? "ol" : "ul";
---

<List
  >{
    items.map((item) => (
      <li>
        <>
          <p>
            <strong>{item.title}</strong>
          </p>
          <p>{item.body}</p>
        </>
      </li>
    ))
  }</List
>
