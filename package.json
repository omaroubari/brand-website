{
  "name": "brandtree-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "docs:dev": "pnpm --filter brandtree build && pnpm --filter docs dev",
    "docs:build": "pnpm --filter brandtree build && pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "sandbox:pack": "pnpm --filter brandtree pack --out ./apps/sandbox/brandtree.tgz",
    "dev": "pnpm --filter brandtree build && pnpm --filter web dev",
    "build": "pnpm --filter brandtree build && pnpm --filter web build",
    "test": "pnpm --filter brandtree test",
    "preview": "pnpm --filter web preview",
    "check": "pnpm --filter brandtree build && pnpm -r --filter=!brandtree-sandbox --if-present check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "pnpm --filter brandtree build && pnpm --filter web deploy",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm --filter brandtree build && changeset publish"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@changesets/cli": "3.0.3"
  }
}
