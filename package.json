{
  "name": "brandtree-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter brandtree test",
    "preview": "pnpm --filter web preview",
    "check": "pnpm -r --if-present check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "pnpm --filter web deploy",
    "astro": "pnpm --filter web astro",
    "generate-types": "pnpm --filter web generate-types"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
