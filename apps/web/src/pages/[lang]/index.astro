---
import { brand, config } from "@/brand/config";
import { resolveBrand } from "brandtree";
import { withBase } from "brandtree/runtime";
import { i18nEnabled, localeDir } from "brandtree";
import { resolveUIStrings } from "brandtree";
import { getNavigation } from "brandtree";
import { getContentTree } from "@/core/loader";
import type { Navigation } from "brandtree";
import {
  CoverPage,
  generatedOgImagePath,
  RootLayout,
  type BareRootLayoutProps,
} from "brandtree/runtime";

interface Props {
  locale: string;
  navigation: Navigation;
}

export async function getStaticPaths() {
  if (!i18nEnabled(config)) {
    return [];
  }

  const tree = await getContentTree();
  return config.i18n.locales
    .filter(
      ({ code }) =>
        !config.i18n.hideDefaultLocalePrefix ||
        code !== config.i18n.defaultLocale,
    )
    .map(({ code }) => ({
      params: { lang: code },
      props: { locale: code, navigation: getNavigation(tree, code) },
    }));
}

const { locale, navigation } = Astro.props;
const localizedBrand = resolveBrand(brand, locale, config.i18n);
const defaultLocale = config.i18n?.defaultLocale ?? "en";
const ui = resolveUIStrings(locale, { defaultLocale });
const dir = localeDir(locale, config.i18n);
const route = navigation.root ?? "/";
const siteUrl = localizedBrand.meta.url.replace(/\/$/u, "");
const absolute = (path: string) =>
  path.startsWith("/") ? `${siteUrl}${withBase(path)}` : path;

const ogGenerated = Boolean(config.seo.og.enabled ?? true);
const ogImage = ogGenerated ? generatedOgImagePath(route) : null;

const tree = await getContentTree();
const localeSwitch = config.i18n
  ? config.i18n.locales.map(({ code, label, dir }) => ({
      code,
      label,
      dir,
      href: getNavigation(tree, code).root ?? "/",
      isCurrent: code === locale,
      isFallback: false,
    }))
  : [];
const localeAlternates = config.i18n.locales.map(({ code }) => ({
  hreflang: code,
  href: absolute(getNavigation(tree, code).root ?? "/"),
}));
const xDefault =
  localeAlternates.find(
    ({ hreflang }) => hreflang === config.i18n.defaultLocale,
  )?.href ?? null;

const layoutProps = {
  brand: localizedBrand,
  contentLayout: "bare",
  site: {
    title: `${localizedBrand.meta.name} — ${localizedBrand.meta.documentTitle}`,
    description: localizedBrand.meta.description,
  },
  logo: {
    light: localizedBrand.logo.logotype.onLight,
    dark: localizedBrand.logo.logotype.onDark,
    alt: localizedBrand.logo.logotype.altText ?? localizedBrand.meta.name,
    href: route,
  },
  favicon: localizedBrand.logo.favicon ?? "/favicon.svg",
  appleIcon: null,
  banner: null,
  analytics: null,
  navigation,
  navigationNumbering: config.navigation.numbering,
  mcp: null,
  page: {
    title: "",
    description: localizedBrand.meta.description,
    route,
  },
  imageZoom: true,
  codeWrap: false,
  themeMode: localizedBrand.theme.default,
  searchEnabled: false,
  indexable: true,
  ogImage: ogImage ? absolute(ogImage) : null,
  ogGenerated,
  x: undefined,
  canonical: absolute(route),
  editUrl: null,
  askEnabled: false,
  feedback: false,
  exportPdf: false,
  exportEpub: false,
  openInChat: [],
  feeds: [],
  discovery: null,
  siteUrl,
  pageType: undefined,
  published: null,
  lastModified: null,
  noindex: false,
  structuredDataEnabled: false,
  locale,
  dir,
  contentDir: dir,
  ui,
  localeSwitch,
  localeAlternates,
  xDefault,
  versionNotice: null,
  searchVersion: null,
} satisfies BareRootLayoutProps;
---

<RootLayout {...layoutProps}>
  <CoverPage
    brand={localizedBrand}
    ui={ui}
    navigation={navigation}
    numbering={config.navigation.numbering}
  />
</RootLayout>
