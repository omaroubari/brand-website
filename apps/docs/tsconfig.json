{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["astro/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    ".blume*/.astro/types.d.ts",
    "blume.config.ts",
    "brandtree.config.ts",
    "components/**/*",
    "examples/**/*",
    "previews/**/*",
    "components.ts"
  ]
}
