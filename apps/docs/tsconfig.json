{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["astro/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
  },
  "include": [
    "blume.config.ts",
    "components/**/*",
    "pages/**/*",
    "components.ts",
  ],
}
