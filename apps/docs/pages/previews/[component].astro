---
import "brandtree/styles.css";
import { brandStyleSheet } from "brandtree";
import ColorInteractions from "../../components/demos/ColorInteractions";
import DemoContent from "../../components/demos/DemoContent.astro";
import { demos } from "../../components/demos/catalog";
import {
  demoBrand,
  demoConfig,
  demoUI,
} from "../../components/demos/demo-data";
import photo from "../../../web/assets/photography/photo-01.jpg";
import { icons } from "../../../web/assets/icons";
import fontUrl from "../../../web/assets/fonts/BrandSans-Variable.ttf?url";

export const prerender = true;
export function getStaticPaths() {
  return demos.map(({ slug, name }) => ({
    params: { component: slug },
    props: { name },
  }));
}

const { name } = Astro.props;
const component = Astro.params.component!;
// This source is a JPEG; keep its format precise across the two Astro versions
// used by the docs host and the framework package.
const previewPhoto = { ...photo, format: "jpg" as const };
const font = demoConfig.fonts[0];
const fontCss = `@font-face {
  font-family: ${JSON.stringify(font.name)};
  src: url(${JSON.stringify(fontUrl)}) format('truetype');
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}
:root { ${font.cssVariable}: ${JSON.stringify(font.name)}, sans-serif; }`;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{name} preview</title>
    <style is:global set:html={brandStyleSheet(demoBrand) + fontCss}></style>
  </head>
  <body>
    <main aria-label={`${name} example`}>
      <DemoContent
        name={component}
        brand={demoBrand}
        ui={demoUI}
        photo={previewPhoto}
        icons={icons}
      />
    </main>
    {
      ["color-palette", "color-scale", "color-swatch"].includes(component) && (
        <ColorInteractions
          labels={{
            close: demoUI.nav.close,
            copied: demoUI.actions.copied,
            copyFailed: demoUI.actions.copyFailed,
            colorCopied: demoUI.color.copied,
          }}
          client:load
        />
      )
    }
  </body>
</html>

<style is:global>
  body {
    margin: 0;
  }
  main {
    padding: var(--space-m);
    min-inline-size: 0;
    overflow-x: auto;
  }
  main > * {
    min-inline-size: 0;
  }
</style>
