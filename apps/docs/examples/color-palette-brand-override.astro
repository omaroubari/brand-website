---
import { ColorPalette } from "brandtree/components";
import PreviewShell from "../previews/PreviewShell.astro";
import { demoBrand as brand, demoUI as ui } from "../previews/brand";
---

<PreviewShell colorInteractions>
  <ColorPalette
    brand={{
      ...brand,
      colors: { ...brand.colors, swatches: brand.colors.swatches.slice(0, 1) },
    }}
    ui={ui}
  />
</PreviewShell>
