---
import { PhotoGrid } from "brandtree/components";
import PreviewShell from "../previews/PreviewShell.astro";
import { demoPhoto as photo } from "../previews/media";
---

<PreviewShell>
  <PhotoGrid
    images={[
      { src: photo, caption: "The original composition" },
      { src: photo, caption: "A second application of the image treatment" },
    ]}
    cols={2}
    ratio="3 / 2"
    treatment="mono"
  />
</PreviewShell>
