---
import { Figure } from "brandtree/components";
import PreviewShell from "../previews/PreviewShell.astro";
import { demoUI as ui } from "../previews/brand";
import { demoPhoto as photo } from "../previews/media";
---

<PreviewShell>
  <Figure
    ui={ui}
    src={photo.src}
    alt="A photograph cropped to a square frame"
    ratio="1 / 1"
    fit="cover"
    caption="Square crop using an image URL"
  />
</PreviewShell>
