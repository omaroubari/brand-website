---
import { PersonaCard } from "brandtree/components";
import PreviewShell from "../previews/PreviewShell.astro";
import { demoUI as ui } from "../previews/brand";
import { demoPortrait as portrait } from "../previews/media";
---

<PreviewShell>
  <PersonaCard
    ui={ui}
    name="Maya"
    role="Brand designer"
    image={portrait}
    facts={[{ term: "Needs", value: "A consistent identity across channels" }]}>
    <p>
      Maya needs clear rules that a small team can apply without supervision.
    </p>
  </PersonaCard>
</PreviewShell>
