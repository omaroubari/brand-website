---
import { Panel, Logo } from "brandtree/components";
import PreviewShell from "../previews/PreviewShell.astro";
import { demoBrand as brand } from "../previews/brand";
---

<PreviewShell>
  <Panel brand={brand} caption="Primary logo">
    <Logo brand={brand} width="60%" />
    <span slot="caption"
      >Primary logo. <strong>Use supplied artwork.</strong></span
    >
  </Panel>
</PreviewShell>
