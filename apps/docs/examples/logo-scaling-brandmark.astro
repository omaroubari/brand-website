---
import { LogoScaling } from "brandtree/components";
import PreviewShell from "../previews/PreviewShell.astro";
import { demoBrand as brand } from "../previews/brand";
---

<PreviewShell>
  <LogoScaling
    brand={brand}
    mark="brandmark"
    sizes={[
      { width: "4rem", label: "Large icon" },
      { width: "2rem", label: "Compact icon" },
    ]}
  />
</PreviewShell>
