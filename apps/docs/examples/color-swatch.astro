---
import { ColorSwatch } from "brandtree/components";
import PreviewShell from "../previews/PreviewShell.astro";
import { demoBrand as brand, demoUI as ui } from "../previews/brand";
---

<PreviewShell colorInteractions>
  <div data-color-palette>
    <ColorSwatch
      brand={brand}
      ui={ui}
      color={brand.colors.swatches[0]}
      print={false}
    />
  </div>
</PreviewShell>
