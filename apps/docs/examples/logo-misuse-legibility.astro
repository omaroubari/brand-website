---
import { LogoMisuse } from "brandtree/components";
import PreviewShell from "../previews/PreviewShell.astro";
import { demoBrand as brand } from "../previews/brand";
---

<PreviewShell>
  <LogoMisuse
    brand={brand}
    cols={3}
    items={[
      {
        effect: "low-contrast",
        title: "Keep enough contrast",
        note: "Choose an approved foreground and background pairing.",
      },
      {
        effect: "too-small",
        title: "Keep the logo legible",
        note: "Respect the published minimum size.",
      },
      {
        effect: "obstruct",
        title: "Keep the logo clear",
        note: "Keep other artwork outside the protected space.",
      },
    ]}
  />
</PreviewShell>
