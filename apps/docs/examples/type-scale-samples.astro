---
import { TypeScale } from "brandtree/components";
import PreviewShell from "../previews/PreviewShell.astro";
import { demoBrand as brand, demoUI as ui } from "../previews/brand";
---

<PreviewShell>
  <TypeScale
    brand={brand}
    ui={ui}
    only={["caption"]}
    print={false}
    sample="A clear voice, wherever we appear."
  />

  <TypeScale brand={brand} ui={ui} only={["caption"]} print={false} />
</PreviewShell>
