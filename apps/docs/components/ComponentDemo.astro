---
import { demos, type DemoName } from "./demos/catalog";
interface Props {
  name: DemoName;
}
const { name } = Astro.props;
const demo = demos.find((item) => item.slug === name)!;
---

<div class="component-demo" data-component-demo>
  <div class="demo-toolbar">
    <span>Preview</span>
    <div class="demo-actions">
      <label>
        <span class="sr-only">Preview theme</span>
        <select data-demo-theme aria-label={`${demo.name} preview theme`}>
          <option value="auto">Match page</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
      <a href={`/previews/${name}`} target="_blank" rel="noopener"
        >Open preview ↗</a
      >
    </div>
  </div>
  <div class="demo-viewport">
    <iframe
      src={`/previews/${name}`}
      title={`${demo.name} live example`}
      loading="lazy"
      height="360"
      data-demo-frame></iframe>
  </div>
</div>

<script>
  function initializeDemos() {
    for (const container of document.querySelectorAll<HTMLElement>(
      "[data-component-demo]",
    )) {
      if (container.dataset.initialized) continue;
      container.dataset.initialized = "true";
      const frame =
        container.querySelector<HTMLIFrameElement>("[data-demo-frame]")!;
      const theme =
        container.querySelector<HTMLSelectElement>("[data-demo-theme]")!;
      let sizeObserver: ResizeObserver | undefined;
      const syncTheme = () => {
        const root = frame.contentDocument?.documentElement;
        if (!root) return;
        const page = document.documentElement;
        root.dataset.theme =
          theme.value === "auto"
            ? (page.dataset.theme ??
              (page.classList.contains("dark") ? "dark" : "light"))
            : theme.value;
      };
      const loaded = () => {
        syncTheme();
        const body = frame.contentDocument?.body;
        if (!body) return;
        const resize = () => {
          frame.style.height = `${Math.ceil(body.getBoundingClientRect().height)}px`;
        };
        sizeObserver?.disconnect();
        sizeObserver = new ResizeObserver(resize);
        sizeObserver.observe(body);
        resize();
      };
      frame.addEventListener("load", loaded);
      if (
        frame.contentDocument?.readyState === "complete" &&
        frame.contentDocument.URL !== "about:blank"
      )
        loaded();
      theme.addEventListener("change", syncTheme);
      const themeObserver = new MutationObserver(syncTheme);
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme", "class"],
      });
      document.addEventListener(
        "astro:before-swap",
        () => {
          sizeObserver?.disconnect();
          themeObserver.disconnect();
        },
        { once: true },
      );
    }
  }
  initializeDemos();
  document.addEventListener("astro:page-load", initializeDemos);
</script>

<style>
  .component-demo {
    margin-block: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-blume);
    overflow: hidden;
  }
  .demo-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-block-end: 1px solid var(--color-border);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .demo-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  select {
    background: var(--color-background);
    color: var(--color-foreground);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-blume);
    padding: 0.25rem 0.5rem;
    font: inherit;
  }
  a {
    color: var(--color-muted-foreground);
    text-decoration: none;
  }
  a:hover {
    color: var(--color-foreground);
  }
  .demo-viewport {
    max-block-size: 36rem;
    overflow: auto;
  }
  iframe {
    display: block;
    inline-size: 100%;
    border: 0;
  }
</style>
