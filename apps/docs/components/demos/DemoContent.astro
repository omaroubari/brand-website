---
import type { ImageMetadata } from "astro";
import type { BrandConfig, UIStrings } from "brandtree";
import {
  Block,
  Callout,
  Figure,
  Grid,
  Panel,
  SpecList,
  Statement,
  ColorPalette,
  ColorScale,
  ColorSwatch,
  ConstructionGrid,
  ContrastMatrix,
  Downloads,
  FontWeights,
  Glyphs,
  IconGrid,
  LayoutGrid,
  Logo,
  LogoClearspace,
  LogoColorways,
  LogoMisuse,
  LogoScaling,
  PersonaCard,
  PhotoGrid,
  ToneSliders,
  TypeScale,
  TypeSpecimen,
  ValueGrid,
} from "brandtree/components";

interface Props {
  name: string;
  brand: BrandConfig;
  ui: UIStrings;
  photo: ImageMetadata;
  icons: Array<{ name: string; svg: string }>;
}

const { name, brand, ui, photo, icons } = Astro.props;
const colorway = brand.logo.colorways[0];
const contrastColors = brand.colors.swatches.slice(0, 3).map(({ id }) => id);
---

{
  name === "block" && (
    <Block id="primary-logo">
      <Fragment slot="copy">
        <h2>Primary logo</h2>
        <p>Use the supplied artwork whenever the full name fits.</p>
      </Fragment>
      <Fragment slot="note">
        <p>Never recreate the logotype using live text.</p>
      </Fragment>
      <Fragment slot="content">
        <Panel brand={brand} ratio="16 / 9">
          <Logo brand={brand} width="66%" />
        </Panel>
      </Fragment>
    </Block>
  )
}

{
  name === "callout" && (
    <Callout ui={ui} tone="dont" title="Keep the original proportions">
      <p>Do not stretch or compress the supplied artwork.</p>
    </Callout>
  )
}

{
  name === "figure" && (
    <Figure
      ui={ui}
      src={photo}
      alt="An example photograph shown inside the brand's image frame"
      caption="Photography application"
      ratio="3 / 2"
      fit="contain"
    />
  )
}

{
  name === "grid" && (
    <Grid cols={2} colsSm={1} gap="var(--space-l)">
      <Figure ui={ui} src={photo} caption="Wide composition" ratio="3 / 2" />
      <Figure ui={ui} src={photo} caption="Square crop" ratio="1 / 1" />
    </Grid>
  )
}

{
  name === "panel" && (
    <Panel
      brand={brand}
      bg={colorway?.bg}
      fg={colorway?.fg}
      ratio="16 / 9"
      caption="An approved color pairing."
      label="Primary">
      <Logo
        brand={brand}
        tint={colorway ? `var(--color-${colorway.fg})` : undefined}
        width="60%"
      />
    </Panel>
  )
}

{
  name === "spec-list" && (
    <SpecList
      items={[
        { term: "Format", value: "SVG" },
        { term: "Use", value: "Digital artwork" },
      ]}
    />
  )
}

{
  name === "statement" && (
    <Statement>
      <p>We help people recognize what matters.</p>
      <p>Every touchpoint should make that promise clear.</p>
    </Statement>
  )
}

{name === "color-palette" && <ColorPalette brand={brand} ui={ui} />}

{name === "color-scale" && <ColorScale brand={brand} ui={ui} />}

{
  name === "color-swatch" && (
    <div data-color-palette>
      <ColorSwatch
        brand={brand}
        ui={ui}
        color={brand.colors.swatches[0]}
        print={false}
      />
    </div>
  )
}

{
  name === "construction-grid" && (
    <ConstructionGrid
      brand={brand}
      mark="brandmark"
      cols={8}
      rows={8}
      caption="Construction grid for the mark"
    />
  )
}

{
  name === "contrast-matrix" && (
    <ContrastMatrix
      brand={brand}
      ui={ui}
      only={contrastColors}
      threshold={4.5}
    />
  )
}

{name === "downloads" && <Downloads brand={brand} items={brand.downloads} />}

{
  name === "font-weights" && (
    <FontWeights brand={brand} font="text" sample="Words with purpose" />
  )
}

{
  name === "glyphs" && (
    <Glyphs
      ui={ui}
      dir="ltr"
      font="display"
      sets={[{ label: "Numerals", chars: "0123456789" }]}
    />
  )
}

{
  name === "icon-grid" && (
    <IconGrid icons={icons} unit={24} cols={4} version="v1.0" />
  )
}

{
  name === "layout-grid" && (
    <LayoutGrid
      columns={12}
      gutter="24px"
      margin="48px"
      ratio="16 / 9"
      label="Desktop composition"
      specs={[{ term: "Alignment", value: "Content follows the column grid" }]}
    />
  )
}

{name === "logo" && <Logo brand={brand} mark="logotype" width="66%" />}

{
  name === "logo-clearspace" && (
    <LogoClearspace brand={brand} ui={ui} mark="brandmark" />
  )
}

{name === "logo-colorways" && <LogoColorways brand={brand} cols={2} />}

{
  name === "logo-misuse" && (
    <LogoMisuse
      brand={brand}
      cols={2}
      items={[
        {
          effect: "stretch",
          title: "Do not stretch",
          note: "Keep the original proportions.",
        },
        {
          effect: "rotate",
          title: "Do not rotate",
          note: "Keep the artwork upright.",
        },
      ]}
    />
  )
}

{
  name === "logo-scaling" && (
    <LogoScaling
      brand={brand}
      sizes={[
        { width: "12rem", label: "Standard application" },
        { width: "4rem", label: "Small digital application" },
      ]}
    />
  )
}

{
  name === "persona-card" && (
    <PersonaCard
      ui={ui}
      name="Maya"
      role="Independent founder"
      image={photo}
      facts={[
        { term: "Needs", value: "A consistent identity across channels" },
      ]}>
      <p>
        Maya needs clear rules that a small team can apply without supervision.
      </p>
    </PersonaCard>
  )
}

{
  name === "photo-grid" && (
    <PhotoGrid
      images={[
        { src: photo, caption: "The original composition" },
        { src: photo, caption: "A second application of the image treatment" },
      ]}
      cols={2}
      ratio="3 / 2"
      treatment="mono"
    />
  )
}

{
  name === "tone-sliders" && (
    <ToneSliders
      items={[
        { left: "Formal", right: "Conversational", at: 70 },
        { left: "Reserved", right: "Expressive", at: 40 },
      ]}
    />
  )
}

{
  name === "type-scale" && (
    <TypeScale
      brand={brand}
      ui={ui}
      only={brand.typography.scale.slice(-3).map(({ id }) => id)}
      print={false}
      sample="A clear voice, wherever we appear."
    />
  )
}

{
  name === "type-specimen" && (
    <TypeSpecimen brand={brand} ui={ui} font="text" glyph="Ag" weight={400} />
  )
}

{
  name === "value-grid" && (
    <ValueGrid
      numbered={false}
      items={[
        { title: "Clarity", body: "Make the important thing easy to find." },
        { title: "Care", body: "Consider the person using the work." },
      ]}
    />
  )
}
