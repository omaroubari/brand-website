---
import Layout from "../layouts/layout.astro";

const capabilities = [
  {
    title: "Responsive by default",
    description: "Designed to work clearly across desktop, tablet, and mobile.",
  },
  {
    title: "Light and dark modes",
    description:
      "A complete theme system that respects each visitor’s preference.",
  },
  {
    title: "Multilingual and RTL",
    description:
      "Localized content and navigation, including right-to-left languages.",
  },
  {
    title: "Interactive specimens",
    description:
      "Useful demonstrations for color, type, logos, grids, and more.",
  },
  {
    title: "Ready-to-use assets",
    description:
      "Organized downloads put approved brand files within easy reach.",
  },
  {
    title: "Easy to share and update",
    description:
      "Structured navigation, social previews, and maintainable content.",
  },
];

const guidelineSections = [
  {
    title: "Brand foundations",
    description: "Purpose, mission, vision, values, and audience",
  },
  {
    title: "Tone and voice",
    description: "Archetypes, positioning, and writing guidance",
  },
  {
    title: "Logo",
    description: "Logotype, brandmark, clear space, sizing, and misuse",
  },
  {
    title: "Color",
    description: "Palettes, scales, proportions, and contrast",
  },
  {
    title: "Typography",
    description: "Typefaces, weights, glyphs, scales, and setting rules",
  },
  {
    title: "Iconography",
    description: "Grid, stroke, construction, and usage",
  },
  {
    title: "Photography",
    description: "Art direction, treatments, selection, and licensing",
  },
  {
    title: "Layout",
    description: "Desktop, mobile, and social media grids",
  },
  {
    title: "Digital",
    description: "Website, favicon, app icon, and social applications",
  },
  {
    title: "Print",
    description: "Stationery, posters, promotional items, and signage",
  },
];
---

<Layout
  title="Brandtree — Turn brand guidelines into brand websites"
  description="Brandtree turns your brand guidelines into a polished, living website your clients and teams can actually use.">
  <div
    id="top"
    class="bg-background text-muted-foreground min-h-screen min-w-80 overflow-x-clip px-6 sm:px-8 lg:px-12">
    <main class="mx-auto w-full max-w-480">
      <section
        class="flex min-h-[calc(100svh-5rem)] flex-col py-10 sm:py-14 lg:py-16"
        aria-labelledby="hero-title">
        <h1
          id="hero-title"
          class="text-foreground pt-16 text-lg font-medium tracking-tight">
          A better way to hand off brand guidelines
        </h1>
        <p class="text-muted-foreground max-w-120">
          We turn the brand systems you create into clear, considered websites,
          so every client leaves with guidelines that are easy to explore,
          share, and keep current.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a
            class="bg-primary hover:bg-primary/80 text-primary-foreground w-fit rounded-full px-4 py-2 text-sm font-medium transition-colors"
            href="https://cal.com/valence/30min">
            Book a meeting
          </a>
          <a
            class="text-muted-foreground hover:text-foreground w-fit text-sm font-medium underline underline-offset-4 transition-colors"
            href="https://brand.byvalence.com/en"
            target="_blank"
            rel="noreferrer">
            View sample site
          </a>
        </div>
      </section>

      <section
        id="process"
        class="py-24 sm:py-32"
        aria-labelledby="process-title">
        <div class="grid gap-6 md:grid-cols-2">
          <h2
            id="process-title"
            class="text-foreground max-w-120 text-lg font-medium tracking-tight">
            From finished identity to living brand website.
          </h2>
          <p class="max-w-120 md:justify-self-end">
            We work as an extension of your studio, translating the thinking
            behind the identity into an experience that feels unmistakably part
            of the brand.
          </p>
        </div>

        <ol class="mt-16 grid gap-4 md:grid-cols-3">
          <li
            class="bg-muted flex min-h-72 flex-col rounded-2xl p-6 sm:min-h-80 sm:p-8">
            <p>01</p>
            <div class="mt-auto">
              <h3 class="text-foreground font-medium">Share the system</h3>
              <p class="mt-2 max-w-80">
                Send over the guidelines, assets, and any context behind the
                decisions.
              </p>
            </div>
          </li>
          <li
            class="bg-muted flex min-h-72 flex-col rounded-2xl p-6 sm:min-h-80 sm:p-8">
            <p>02</p>
            <div class="mt-auto">
              <h3 class="text-foreground font-medium">
                We shape the experience
              </h3>
              <p class="mt-2 max-w-80">
                We structure, design, and build a website around the identity,
                not a generic template.
              </p>
            </div>
          </li>
          <li
            class="bg-muted flex min-h-72 flex-col rounded-2xl p-6 sm:min-h-80 sm:p-8">
            <p>03</p>
            <div class="mt-auto">
              <h3 class="text-foreground font-medium">
                Hand off with confidence
              </h3>
              <p class="mt-2 max-w-80">
                Your client gets a polished, responsive home for every rule,
                asset, and idea.
              </p>
            </div>
          </li>
        </ol>
      </section>

      <section class="py-24 sm:py-32" aria-labelledby="capabilities-title">
        <div class="grid gap-6 md:grid-cols-2">
          <h2
            id="capabilities-title"
            class="text-foreground max-w-120 text-lg font-medium tracking-tight">
            Everything a living brand guide needs.
          </h2>
          <p class="max-w-120 md:justify-self-end">
            More useful than a PDF and easier to navigate than a shared folder.
            Every site includes the practical features teams need to understand
            and apply the brand.
          </p>
        </div>

        <ul class="mt-16 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {
            capabilities.map((capability) => (
              <li class="bg-muted flex min-h-56 flex-col rounded-2xl p-6 sm:p-8">
                <h3 class="text-foreground font-medium">{capability.title}</h3>
                <p class="mt-auto max-w-80">{capability.description}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="py-24 sm:py-32" aria-labelledby="sections-title">
        <div class="grid gap-6 md:grid-cols-2">
          <h2
            id="sections-title"
            class="text-foreground max-w-120 text-lg font-medium tracking-tight">
            Built around a complete brand system.
          </h2>
          <p class="max-w-120 md:justify-self-end">
            This is a starting structure, not a fixed template. Keep only the
            sections the identity needs, expand them, or add custom sections to
            match the guidelines your agency designed.
          </p>
        </div>

        <ol class="border-border mt-16 border-t">
          {
            guidelineSections.map((section, index) => (
              <li class="border-border grid gap-2 border-b py-5 sm:grid-cols-[3rem_1fr_1fr] sm:gap-6">
                <p>{String(index + 1).padStart(2, "0")}</p>
                <h3 class="text-foreground font-medium">{section.title}</h3>
                <p>{section.description}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="offer" class="py-24 sm:py-32" aria-labelledby="offer-title">
        <div class="grid gap-6 md:grid-cols-2">
          <h2
            id="offer-title"
            class="text-foreground max-w-120 text-lg font-medium tracking-tight">
            An early-partner rate, for a limited time.
          </h2>
          <p class="max-w-120 md:justify-self-end">
            While we refine the product and learn from working studios, we’re
            offering the complete service at half the usual price in exchange
            for honest feedback.
          </p>
        </div>

        <div
          class="bg-muted mt-16 grid overflow-hidden rounded-2xl p-6 sm:p-8 md:grid-cols-2">
          <div class="flex min-h-72 flex-col pb-6 md:pb-0">
            <p>Complete brand website</p>
            <div class="mt-auto">
              <div class="flex items-baseline gap-3">
                <p class="text-foreground text-lg font-medium">$550</p>
                <p class="line-through">$1,100</p>
              </div>
              <p class="mt-2 max-w-80">Limited-time project rate.</p>
            </div>
          </div>

          <div class="border-border border-t md:border-t-0 md:border-l">
            <div class="flex min-h-72 flex-col pt-6 sm:ps-8 sm:pt-0">
              <p>Average turnaround</p>
              <div class="mt-auto">
                <p class="text-foreground text-lg font-medium">
                  4–5 business days
                </p>
                <p class="mt-2 max-w-80">
                  From receiving your final guidelines, assets, and content.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        class="grid gap-10 py-24 sm:py-32 md:grid-cols-2"
        aria-labelledby="partnership-title">
        <h2
          id="partnership-title"
          class="text-foreground max-w-120 text-lg font-medium tracking-tight">
          Your design stays at the center.
        </h2>
        <div class="md:justify-self-end">
          <p class="max-w-120">
            No competing aesthetic and no awkward handoff. We preserve the
            intent of your work, fill the gaps that appear on screen, and make
            the finished site feel like it came directly from your team.
          </p>
          <p class="text-foreground mt-8 max-w-120 font-medium">
            White-label friendly. Built for launch. Easy to keep current.
          </p>
        </div>
      </section>

      <section
        class="bg-muted mb-12 flex min-h-112 flex-col items-center justify-center rounded-3xl px-6 py-20 text-center sm:px-10"
        aria-labelledby="closing-title">
        <h2
          id="closing-title"
          class="text-foreground max-w-160 text-lg font-medium tracking-tight">
          Give your next identity a better handoff.
        </h2>
        <p class="mt-3 max-w-120">
          Bring the brand system. We’ll turn it into a website your client will
          want to use.
        </p>
        <a
          class="bg-primary hover:bg-primary/80 text-primary-foreground mt-4 w-fit rounded-full px-4 py-2 text-sm font-medium transition-colors"
          href="https://cal.com/valence/30min">
          Book a meeting
        </a>
      </section>
    </main>

    <footer
      class="mx-auto flex min-h-24 w-full max-w-480 items-center justify-between text-sm">
      <a
        class="text-muted-foreground hover:text-foreground ms-auto font-medium transition-colors"
        href="#top">
        Back to top <span aria-hidden="true">↑</span>
      </a>
    </footer>
  </div>
</Layout>
